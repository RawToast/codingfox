{
  "name": "codefox",
  "version": "0.0.0",
  "private": true,
  "description": "CodeFox - AI-Powered Pull Request Reviewer. Stop shipping slop. Start shipping quality.",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/main.ts --outfile dist/index.js --target node --format cjs --minify && cp node_modules/@dqbd/tiktoken/tiktoken_bg.wasm dist/tiktoken_bg.wasm",
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "lint": "oxlint src/",
    "format": "oxfmt --write src/ __tests__/",
    "format:check": "oxfmt --check src/ __tests__/",
    "typecheck": "tsc --noEmit",
    "all": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codefox/ai-pr-reviewer.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^5.1.1",
    "@ai-sdk/anthropic": "3.0.2",
    "@ai-sdk/openai": "3.0.2",
    "@ai-sdk/openai-compatible": "2.0.2",
    "@dqbd/tiktoken": "^1.0.7",
    "@octokit/action": "^6.0.4",
    "@octokit/plugin-retry": "^4.1.3",
    "@octokit/plugin-throttling": "^6.1.0",
    "ai": "6.0.6",
    "minimatch": "^9.0.1",
    "p-limit": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.4.2",
    "oxfmt": "^0.21.0",
    "oxlint": "^0.16.0",
    "typescript": "^5.7.0"
  }
}
